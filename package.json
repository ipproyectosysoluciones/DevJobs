{
  "name": "devjobs",
  "version": "1.0.0",
  "description": "Portal DevJobs con NodeJS, TypeScript, Handlebars, Mongoose",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "start:dev": "NODE_OPTIONS='--no-warnings' node --import tsx src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky install",
    "commit": "git-cz",
    "seed": "tsx src/seed.ts"
  },
  "author": "Bladimir Gerson Parra Bermudez",
  "license": "MIT",
  "dependencies": {
    "@types/socket.io": "^3.0.2",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-handlebars": "9.0.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "http-errors": "^2.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.6.2",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "nodemailer-express-handlebars": "7.0.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "shortid": "^2.2.17",
    "slug": "^11.0.1",
    "socket.io": "^4.8.3",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/http-errors": "^2.0.5",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.2",
    "@types/nodemailer": "^8.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/shortid": "^2.2.0",
    "@types/slug": "^5.0.9",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "vite": "^6.4.2",
    "vitest": "^4.1"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
