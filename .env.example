# ============================================
# DevJobs Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# ============================================
# Application
# ============================================
NODE_ENV=development
PORT=3000
SECRETO=devjobs-secret-change-in-production

# ============================================
# Database
# ============================================
MONGODB_URI=mongodb://localhost:27017/devjobs
MONGO_USER=admin
MONGO_PASSWORD=devjobs123

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_ALGORITHM=HS256

# ============================================
# BuilderBot Chat
# ============================================
BUILDERBOT_URL=http://localhost:3008
BUILDERBOT_API_KEY=
OPENAI_API_KEY=

# ============================================
# OAuth Providers
# ============================================
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:3000/api/auth/linkedin/callback

# ============================================
# Payment Gateways
# ============================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ============================================
# Email (Nodemailer)
# ============================================
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@devjobs.com

# ============================================
# Frontend URL (for CORS)
# ============================================
FRONTEND_URL=http://localhost:5173
