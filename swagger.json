{
  "openapi": "3.0.3",
  "info": {
    "title": "DevJobs API",
    "description": "API para el portal de empleo DevJobs - Job portal API for developers\n\n## Autenticación | Authentication\n- Sesiones con express-session\n- Passport.js para autenticación local\n\n## Tipos de usuario | User Types\n- **Público**: Puede buscar y ver vacantes\n- **Usuario autenticado**: Puede crear, editar y eliminar vacantes",
    "version": "1.0.0",
    "contact": {
      "name": "Bladimir Gerson Parra Bermudez"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor de desarrollo | Development server"
    }
  ],
  "tags": [
    {
      "name": "Vacantes",
      "description": "Operaciones con vacantes de trabajo | Job vacancy operations"
    },
    {
      "name": "Usuarios",
      "description": "Operaciones de usuario | User operations"
    },
    {
      "name": "Auth",
      "description": "Autenticación y sesiones | Authentication and sessions"
    },
    {
      "name": "Búsqueda",
      "description": "Búsqueda de vacantes | Job search"
    },
    {
      "name": "Autenticación",
      "description": "API de autenticación JWT | JWT Authentication API"
    },
    {
      "name": "Empleos",
      "description": "Gestión de empleos | Jobs management"
    },
    {
      "name": "Chat",
      "description": "Chat BuilderBot | BuilderBot chat"
    },
    {
      "name": "Donaciones",
      "description": "Sistema de donaciones | Donations system"
    },
    {
      "name": "Analíticas",
      "description": "Analíticas y métricas | Analytics and metrics"
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Registrar nuevo usuario | Register new user",
        "description": "Crea una nueva cuenta de usuario en el sistema | Creates a new user account in the system",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "name", "role"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Correo electrónico del usuario | User email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 8,
                    "description": "Contraseña del usuario | User password"
                  },
                  "name": {
                    "type": "string",
                    "description": "Nombre completo del usuario | User full name"
                  },
                  "role": {
                    "type": "string",
                    "enum": ["admin", "employer", "job_seeker", "premium", "moderator"],
                    "description": "Rol del usuario | User role"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario creado exitosamente | User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token JWT de acceso | JWT access token"
                    },
                    "user": {
                      "type": "object",
                      "description": "Datos del usuario | User data"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos o usuario ya existe | Invalid data or user already exists"
          },
          "500": {
            "description": "Error interno del servidor | Internal server error"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Autenticación"],
        "summary": "Iniciar sesión | Login",
        "description": "Autentica a un usuario y retorna token JWT | Authenticates a user and returns JWT token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Correo electrónico | Email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "description": "Contraseña | Password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login exitoso | Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "user": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas | Invalid credentials"
          }
        }
      }
    },
    "/api/auth/profile": {
      "get": {
        "tags": ["Autenticación"],
        "summary": "Obtener perfil de usuario | Get user profile",
        "description": "Retorna los datos del usuario autenticado | Returns authenticated user data",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil del usuario | User profile"
          },
          "401": {
            "description": "No autorizado | Unauthorized"
          }
        }
      }
    },
    "/api/jobs": {
      "get": {
        "tags": ["Empleos"],
        "summary": "Obtener lista de empleos | Get jobs list",
        "description": "Retorna lista de empleos con filtros y paginación | Returns jobs list with filters and pagination",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Texto de búsqueda | Search text"
          },
          {
            "name": "city",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Ciudad | City"
          },
          {
            "name": "country",
            "in": "query",
            "schema": { "type": "string" },
            "description": "País | Country"
          },
          {
            "name": "remote",
            "in": "query",
            "schema": { "type": "boolean" },
            "description": "Solo remotos | Remote only"
          },
          {
            "name": "type",
            "in": "query",
            "schema": { "type": "string", "enum": ["full-time", "part-time", "contract", "internship", "freelance"] },
            "description": "Tipo de empleo | Job type"
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 },
            "description": "Página | Page"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 10 },
            "description": "Límite por página | Limit per page"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de empleos | Jobs list"
          }
        }
      },
      "post": {
        "tags": ["Empleos"],
        "summary": "Crear nuevo empleo | Create new job",
        "description": "Crea una nueva vacante de empleo | Creates a new job vacancy",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "description", "requirements"],
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "requirements": { "type": "array", "items": { "type": "string" } },
                  "location": {
                    "type": "object",
                    "properties": {
                      "city": { "type": "string" },
                      "country": { "type": "string" },
                      "remote": { "type": "boolean" }
                    }
                  },
                  "salary": {
                    "type": "object",
                    "properties": {
                      "min": { "type": "number" },
                      "max": { "type": "number" },
                      "currency": { "type": "string" }
                    }
                  },
                  "type": { "type": "string", "enum": ["full-time", "part-time", "contract", "internship", "freelance"] }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Empleo creado | Job created" },
          "401": { "description": "No autenticado | Not authenticated" }
        }
      }
    },
    "/api/jobs/{id}": {
      "get": {
        "tags": ["Empleos"],
        "summary": "Obtener empleo por ID | Get job by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "ID del empleo | Job ID"
          }
        ],
        "responses": {
          "200": { "description": "Empleo encontrado | Job found" },
          "404": { "description": "Empleo no encontrado | Job not found" }
        }
      },
      "put": {
        "tags": ["Empleos"],
        "summary": "Actualizar empleo | Update job",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Empleo actualizado | Job updated" },
          "403": { "description": "No autorizado | Not authorized" }
        }
      },
      "delete": {
        "tags": ["Empleos"],
        "summary": "Eliminar empleo | Delete job",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Empleo eliminado | Job deleted" },
          "403": { "description": "No autorizado | Not authorized" }
        }
      }
    },
    "/api/jobs/{id}/apply": {
      "post": {
        "tags": ["Empleos"],
        "summary": "Aplicar a empleo | Apply to job",
        "description": "Postula a un empleo existente | Applies to an existing job",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "coverLetter": { "type": "string" },
                  "resume": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Postulación exitosa | Application successful" },
          "400": { "description": "Ya aplicaste | Already applied" }
        }
      }
    },
    "/api/applications/me": {
      "get": {
        "tags": ["Empleos"],
        "summary": "Mis postulaciones | My applications",
        "description": "Retorna las postulaciones del usuario actual | Returns current user's applications",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Lista de postulaciones | Applications list" }
        }
      }
    },
    "/api/donations/plans": {
      "get": {
        "tags": ["Donaciones"],
        "summary": "Obtener planes de patrocinio | Get sponsorship plans",
        "description": "Retorna los planes de donación disponibles | Returns available donation plans",
        "responses": {
          "200": { "description": "Lista de planes | Plans list" }
        }
      }
    },
    "/api/donations": {
      "post": {
        "tags": ["Donaciones"],
        "summary": "Crear donación | Create donation",
        "description": "Inicia el proceso de donación | Starts donation process",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount", "paymentMethod"],
                "properties": {
                  "amount": { "type": "number", "minimum": 1 },
                  "currency": { "type": "string", "default": "USD" },
                  "paymentMethod": { "type": "string", "enum": ["stripe", "paypal"] },
                  "planId": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Sesión de checkout | Checkout session" }
        }
      }
    },
    "/api/donations/me": {
      "get": {
        "tags": ["Donaciones"],
        "summary": "Mis donaciones | My donations",
        "description": "Retorna las donaciones del usuario actual | Returns current user's donations",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Lista de donaciones | Donations list" }
        }
      }
    },
    "/api/donations/stats": {
      "get": {
        "tags": ["Donaciones"],
        "summary": "Estadísticas de donaciones | Donations stats",
        "description": "Retorna estadísticas de donaciones | Returns donation statistics",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Estadísticas | Statistics" }
        }
      }
    },
    "/api/donations/webhooks/stripe": {
      "post": {
        "tags": ["Donaciones"],
        "summary": "Webhook de Stripe | Stripe webhook",
        "description": "Procesa eventos de Stripe | Processes Stripe events",
        "responses": {
          "200": { "description": "Webhook procesado | Webhook processed" }
        }
      }
    },
    "/api/donations/webhooks/paypal": {
      "post": {
        "tags": ["Donaciones"],
        "summary": "Webhook de PayPal | PayPal webhook",
        "description": "Procesa eventos de PayPal | Processes PayPal events",
        "responses": {
          "200": { "description": "Webhook procesado | Webhook processed" }
        }
      }
    },
    "/api/analytics/events": {
      "post": {
        "tags": ["Analíticas"],
        "summary": "Registrar evento | Track event",
        "description": "Registra un evento de analítica | Tracks an analytics event",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["eventType"],
                "properties": {
                  "eventType": { "type": "string", "enum": ["page_view", "button_click", "form_submit", "search", "job_view", "job_apply", "user_register", "user_login", "chat_message", "donation", "error"] },
                  "data": { "type": "object" },
                  "metadata": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Evento registrado | Event tracked" }
        }
      }
    },
    "/api/analytics/dashboard": {
      "get": {
        "tags": ["Analíticas"],
        "summary": "Métricas del dashboard | Dashboard metrics",
        "description": "Retorna métricas para el dashboard | Returns dashboard metrics",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Métricas del dashboard | Dashboard metrics" }
        }
      }
    },
    "/api/analytics/users": {
      "get": {
        "tags": ["Analíticas"],
        "summary": "Métricas de usuarios | User metrics",
        "description": "Retorna métricas de usuarios | Returns user metrics",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Métricas de usuarios | User metrics" }
        }
      }
    },
    "/api/analytics/jobs": {
      "get": {
        "tags": ["Analíticas"],
        "summary": "Métricas de empleos | Job metrics",
        "description": "Retorna métricas de empleos | Returns job metrics",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Métricas de empleos | Job metrics" }
        }
      }
    },
    "/api/analytics/trends": {
      "get": {
        "tags": ["Analíticas"],
        "summary": "Tendencias de visitas | Visit trends",
        "description": "Retorna tendencias de visitas | Returns visit trends",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Tendencias | Trends" }
        }
      }
    },
    "/api/analytics/report": {
      "get": {
        "tags": ["Analíticas"],
        "summary": "Reporte de analíticas | Analytics report",
        "description": "Retorna un reporte completo | Returns a complete report",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Reporte | Report" }
        }
      }
    },
    "/": {
      "get": {
        "tags": ["Vacantes"],
        "summary": "Página principal - listar vacantes | Home page - list vacancies",
        "description": "Renderiza la página principal con todas las vacantes disponibles | Renders the home page with all available vacancies",
        "responses": {
          "200": {
            "description": "Página HTML con lista de vacantes | HTML page with vacancy list"
          }
        }
      }
    },
    "/vacantes/{url}": {
      "get": {
        "tags": ["Vacantes"],
        "summary": "Detalle de vacante por URL | Vacancy detail by URL",
        "parameters": [
          {
            "name": "url",
            "in": "path",
            "required": true,
            "description": "URL única de la vacante | Unique vacancy URL",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página HTML con detalle de la vacante | HTML page with vacancy details"
          },
          "404": {
            "description": "Vacante no encontrada | Vacancy not found"
          }
        }
      },
      "post": {
        "tags": ["Vacantes"],
        "summary": "Postular a una vacante (enviar CV) | Apply to a vacancy (submit CV)",
        "parameters": [
          {
            "name": "url",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "type": "string",
                    "description": "Nombre del candidato | Candidate name"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Email del candidato | Candidate email"
                  },
                  "cv": {
                    "type": "string",
                    "format": "binary",
                    "description": "Archivo PDF del CV | CV PDF file"
                  }
                },
                "required": ["nombre", "email", "cv"]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect a la página principal | Redirect to home page"
          }
        }
      }
    },
    "/buscador": {
      "post": {
        "tags": ["Búsqueda"],
        "summary": "Buscar vacantes por texto | Search vacancies by text",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "q": {
                    "type": "string",
                    "description": "Texto de búsqueda | Search query"
                  }
                },
                "required": ["q"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Página HTML con resultados de búsqueda | HTML page with search results"
          }
        }
      }
    },
    "/crear-cuenta": {
      "get": {
        "tags": ["Usuarios"],
        "summary": "Formulario de registro | Registration form",
        "responses": {
          "200": {
            "description": "Página HTML con formulario de registro | HTML page with registration form"
          }
        }
      },
      "post": {
        "tags": ["Usuarios"],
        "summary": "Crear cuenta de usuario | Create user account",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "type": "string",
                    "description": "Nombre completo | Full name"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Correo electrónico | Email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "description": "Password"
                  },
                  "confirmar": {
                    "type": "string",
                    "format": "password",
                    "description": "Confirmar password | Confirm password"
                  }
                },
                "required": ["nombre", "email", "password", "confirmar"]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect a iniciar sesión | Redirect to sign in page"
          }
        }
      }
    },
    "/iniciar-sesion": {
      "get": {
        "tags": ["Auth"],
        "summary": "Formulario de inicio de sesión | Sign in form",
        "responses": {
          "200": {
            "description": "Página HTML con formulario de login | HTML page with login form"
          }
        }
      },
      "post": {
        "tags": ["Auth"],
        "summary": "Autenticar usuario | Authenticate user",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Correo electrónico | Email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "description": "Password"
                  }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect a panel de administración (éxito) o formulario (error) | Redirect to admin panel (success) or form (error)"
          }
        }
      }
    },
    "/cerrar-sesion": {
      "get": {
        "tags": ["Auth"],
        "summary": "Cerrar sesión | Sign out",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect a la página principal | Redirect to home page"
          }
        }
      }
    },
    "/administracion": {
      "get": {
        "tags": ["Vacantes"],
        "summary": "Panel de administración | Admin panel",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Página HTML del panel de administración | HTML admin panel page"
          },
          "302": {
            "description": "Redirect a login si no autenticado | Redirect to login if not authenticated"
          }
        }
      }
    },
    "/vacantes/nueva": {
      "get": {
        "tags": ["Vacantes"],
        "summary": "Formulario nueva vacante | New vacancy form",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Página HTML con formulario | HTML page with form"
          }
        }
      },
      "post": {
        "tags": ["Vacantes"],
        "summary": "Crear nueva vacante | Create new vacancy",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "titulo": {
                    "type": "string",
                    "description": "Título del puesto | Job title"
                  },
                  "empresa": {
                    "type": "string",
                    "description": "Nombre de la empresa | Company name"
                  },
                  "ubicacion": {
                    "type": "string",
                    "description": "Ubicación | Location"
                  },
                  "salario": {
                    "type": "string",
                    "description": "Salario | Salary"
                  },
                  "contrato": {
