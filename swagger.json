{
  "openapi": "3.0.3",
  "info": {
    "title": "DevJobs API",
    "description": "API para el portal de empleo DevJobs - Job portal API for developers\n\n## Autenticación | Authentication\n- Sesiones con express-session\n- Passport.js para autenticación local\n\n## Tipos de usuario | User Types\n- **Público**: Puede buscar y ver vacantes\n- **Usuario autenticado**: Puede crear, editar y eliminar vacantes",
    "version": "1.0.0",
    "contact": {
      "name": "Bladimir Gerson Parra Bermudez"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor de desarrollo | Development server"
    }
  ],
  "tags": [
    {
      "name": "Vacantes",
      "description": "Operaciones con vacantes de trabajo | Job vacancy operations"
    },
    {
      "name": "Usuarios",
      "description": "Operaciones de usuario | User operations"
    },
    {
      "name": "Auth",
      "description": "Autenticación y sesiones | Authentication and sessions"
    },
    {
      "name": "Búsqueda",
      "description": "Búsqueda de vacantes | Job search"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["Vacantes"],
        "summary": "Página principal - listar vacantes | Home page - list vacancies",
        "description": "Renderiza la página principal con todas las vacantes disponibles | Renders the home page with all available vacancies",
        "responses": {
          "200": {
            "description": "Página HTML con lista de vacantes | HTML page with vacancy list"
          }
        }
      }
    },
    "/vacantes/{url}": {
      "get": {
        "tags": ["Vacantes"],
        "summary": "Detalle de vacante por URL | Vacancy detail by URL",
        "parameters": [
          {
            "name": "url",
            "in": "path",
            "required": true,
            "description": "URL única de la vacante | Unique vacancy URL",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página HTML con detalle de la vacante | HTML page with vacancy details"
          },
          "404": {
            "description": "Vacante no encontrada | Vacancy not found"
          }
        }
      },
      "post": {
        "tags": ["Vacantes"],
        "summary": "Postular a una vacante (enviar CV) | Apply to a vacancy (submit CV)",
        "parameters": [
          {
            "name": "url",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "type": "string",
                    "description": "Nombre del candidato | Candidate name"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Email del candidato | Candidate email"
                  },
                  "cv": {
                    "type": "string",
                    "format": "binary",
                    "description": "Archivo PDF del CV | CV PDF file"
                  }
                },
                "required": ["nombre", "email", "cv"]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect a la página principal | Redirect to home page"
          }
        }
      }
    },
    "/buscador": {
      "post": {
        "tags": ["Búsqueda"],
        "summary": "Buscar vacantes por texto | Search vacancies by text",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "q": {
                    "type": "string",
                    "description": "Texto de búsqueda | Search query"
                  }
                },
                "required": ["q"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Página HTML con resultados de búsqueda | HTML page with search results"
          }
        }
      }
    },
    "/crear-cuenta": {
      "get": {
        "tags": ["Usuarios"],
        "summary": "Formulario de registro | Registration form",
        "responses": {
          "200": {
            "description": "Página HTML con formulario de registro | HTML page with registration form"
          }
        }
      },
      "post": {
        "tags": ["Usuarios"],
        "summary": "Crear cuenta de usuario | Create user account",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "type": "string",
                    "description": "Nombre completo | Full name"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Correo electrónico | Email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "description": "Password"
                  },
                  "confirmar": {
                    "type": "string",
                    "format": "password",
                    "description": "Confirmar password | Confirm password"
                  }
                },
                "required": ["nombre", "email", "password", "confirmar"]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect a iniciar sesión | Redirect to sign in page"
          }
        }
      }
    },
    "/iniciar-sesion": {
      "get": {
        "tags": ["Auth"],
        "summary": "Formulario de inicio de sesión | Sign in form",
        "responses": {
          "200": {
            "description": "Página HTML con formulario de login | HTML page with login form"
          }
        }
      },
      "post": {
        "tags": ["Auth"],
        "summary": "Autenticar usuario | Authenticate user",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Correo electrónico | Email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "description": "Password"
                  }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect a panel de administración (éxito) o formulario (error) | Redirect to admin panel (success) or form (error)"
          }
        }
      }
    },
    "/cerrar-sesion": {
      "get": {
        "tags": ["Auth"],
        "summary": "Cerrar sesión | Sign out",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect a la página principal | Redirect to home page"
          }
        }
      }
    },
    "/administracion": {
      "get": {
        "tags": ["Vacantes"],
        "summary": "Panel de administración | Admin panel",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Página HTML del panel de administración | HTML admin panel page"
          },
          "302": {
            "description": "Redirect a login si no autenticado | Redirect to login if not authenticated"
          }
        }
      }
    },
    "/vacantes/nueva": {
      "get": {
        "tags": ["Vacantes"],
        "summary": "Formulario nueva vacante | New vacancy form",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Página HTML con formulario | HTML page with form"
          }
        }
      },
      "post": {
        "tags": ["Vacantes"],
        "summary": "Crear nueva vacante | Create new vacancy",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "titulo": {
                    "type": "string",
                    "description": "Título del puesto | Job title"
                  },
                  "empresa": {
                    "type": "string",
                    "description": "Nombre de la empresa | Company name"
                  },
                  "ubicacion": {
                    "type": "string",
                    "description": "Ubicación | Location"
                  },
                  "salario": {
                    "type": "string",
                    "description": "Salario | Salary"
                  },
                  "contrato": {
                    "type": "string",
                    "description": "Tipo de contrato | Contract type"
                  },
                  "descripcion": {
                    "type": "string",
                    "description": "Descripción del puesto | Job description"
                  },
                  "skills": {
                    "type": "string",
                    "description": "Skills separados por coma | Skills separated by comma"
                  }
                },
                "required": ["titulo", "empresa", "ubicacion", "contrato", "skills"]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect a la vacante creada | Redirect to created vacancy"
          }
        }
      }
    },
    "/vacantes/editar/{url}": {
      "get": {
        "tags": ["Vacantes"],
        "summary": "Formulario editar vacante | Edit vacancy form",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "url",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "URL de la vacante a editar | Vacancy URL to edit"
          }
        ],
        "responses": {
          "200": {
            "description": "Página HTML con formulario de edición | HTML page with edit form"
          },
          "404": {
            "description": "Vacante no encontrada | Vacancy not found"
          }
        }
      },
      "post": {
        "tags": ["Vacantes"],
        "summary": "Actualizar vacante | Update vacancy",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "url",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "URL de la vacante a editar | Vacancy URL to edit"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "titulo": {
                    "type": "string"
                  },
                  "empresa": {
                    "type": "string"
                  },
                  "ubicacion": {
                    "type": "string"
                  },
                  "salario": {
                    "type": "string"
                  },
                  "contrato": {
                    "type": "string"
                  },
                  "descripcion": {
                    "type": "string"
                  },
                  "skills": {
                    "type": "string",
                    "description": "Skills separados por coma | Skills separated by comma"
                  }
                },
                "required": ["titulo", "empresa", "ubicacion", "contrato", "skills"]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect a la vacante actualizada | Redirect to updated vacancy"
          }
        }
      }
    },
    "/vacantes/eliminar/{id}": {
      "delete": {
        "tags": ["Vacantes"],
        "summary": "Eliminar vacante | Delete vacancy",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID de la vacante a eliminar | Vacancy ID to delete"
          }
        ],
        "responses": {
          "200": {
            "description": "Vacante eliminada | Vacancy deleted"
          },
          "403": {
            "description": "No autorizado (no eres el autor) | Unauthorized (not the author)"
          }
        }
      }
    },
    "/candidatos/{id}": {
      "get": {
        "tags": ["Vacantes"],
        "summary": "Ver candidatos de una vacante | View vacancy candidates",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID de la vacante | Vacancy ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Página HTML con lista de candidatos | HTML page with candidates list"
          },
          "404": {
            "description": "Vacante no encontrada | Vacancy not found"
          }
        }
      }
    },
    "/reestablecer-password": {
      "get": {
        "tags": ["Auth"],
        "summary": "Formulario solicitar reset de password | Request password reset form",
        "responses": {
          "200": {
            "description": "Página HTML con formulario | HTML page with form"
          }
        }
      },
      "post": {
        "tags": ["Auth"],
        "summary": "Enviar token de reset por email | Send reset token by email",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Email del usuario | User email"
                  }
                },
                "required": ["email"]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect con mensaje de confirmación | Redirect with confirmation message"
          }
        }
      }
    },
    "/reestablecer-password/{token}": {
      "get": {
        "tags": ["Auth"],
        "summary": "Formulario para nuevo password | New password form",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Token de reset | Reset token"
          }
        ],
        "responses": {
          "200": {
            "description": "Página HTML con formulario de nuevo password | HTML page with new password form"
          },
          "302": {
            "description": "Redirect si el token es inválido | Redirect if token is invalid"
          }
        }
      },
      "post": {
        "tags": ["Auth"],
        "summary": "Guardar nuevo password | Save new password",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Token de reset | Reset token"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "password": {
                    "type": "string",
                    "format": "password",
                    "description": "Nuevo password | New password"
                  },
                  "confirmar": {
                    "type": "string",
                    "format": "password",
                    "description": "Confirmar nuevo password | Confirm new password"
                  }
                },
                "required": ["password", "confirmar"]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect a iniciar sesión | Redirect to sign in"
          }
        }
      }
    },
    "/editar-perfil": {
      "get": {
        "tags": ["Usuarios"],
        "summary": "Formulario editar perfil | Edit profile form",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Página HTML con formulario de edición | HTML page with edit form"
          }
        }
      },
      "post": {
        "tags": ["Usuarios"],
        "summary": "Actualizar perfil de usuario | Update user profile",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "type": "string",
                    "description": "Nombre completo | Full name"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Correo electrónico | Email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "description": "Nuevo password (opcional) | New password (optional)"
                  },
                  "imagen": {
                    "type": "string",
                    "format": "binary",
                    "description": "Imagen de perfil (JPEG/PNG) | Profile image (JPEG/PNG)"
                  }
                },
                "required": ["nombre", "email"]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect a panel de administración | Redirect to admin panel"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Vacante": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string",
            "description": "Título del puesto | Job title"
          },
          "empresa": {
            "type": "string",
            "description": "Nombre de la empresa | Company name"
          },
          "ubicacion": {
            "type": "string",
            "description": "Ubicación del trabajo | Job location"
          },
          "salario": {
            "type": "string",
            "description": "Salario ofrecido | Offered salary"
          },
          "contrato": {
            "type": "string",
            "description": "Tipo de contrato | Contract type"
          },
          "descripcion": {
            "type": "string",
            "description": "Descripción del puesto | Job description"
          },
          "url": {
            "type": "string",
            "description": "URL única | Unique URL"
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Skills requeridos | Required skills"
          },
          "candidatos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Candidato"
            },
            "description": "Candidatos aplicados | Applied candidates"
          }
        }
      },
      "Candidato": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "description": "Nombre del candidato | Candidate name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email del candidato | Candidate email"
          },
          "cv": {
            "type": "string",
            "description": "Nombre del archivo CV | CV filename"
          }
        }
      },
      "Usuario": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "description": "Nombre completo | Full name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Correo electrónico | Email"
          },
          "imagen": {
            "type": "string",
            "description": "URL de imagen de perfil | Profile image URL"
          }
        }
      }
    },
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "connect.sid"
      }
    }
  }
}